<?xml version="1.0" encoding="UTF-8"?>
<!--
    GTV Home Screen Layout - Arctic Fuse Double Mod
    Activate via: Skin.SetString(Hub.Home.ReplaceWindow,1190)

    Screen layout (1920x1080):
      y=0-80    Top navigation bar (overlays hero)
      y=0-620   Hero spotlight area (fanart bg + info overlay)
      y=620-872 "Top picks for you" row   (h=200 panel, ends y=872)
      y=872-1080 "Your apps" row           (h=158 panel, ends y=1080)
-->
<includes>

    <include name="GTV_Home_Layout">
        <definition>

            <!-- ──────────────────────────────────────────────────
                 BACKGROUNDS
                 ────────────────────────────────────────────────── -->

            <!-- Solid near-black fallback -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>ff0d0d0d</colordiffuse>
            </control>

            <!-- Hero fanart — driven by widget container via Art(fanart) -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>640</height>
                <texture background="true">$INFO[Container(19010).ListItem.Art(fanart)]</texture>
                <aspectratio>scale</aspectratio>
                <fadetime>800</fadetime>
            </control>

            <!-- Top vignette — keeps nav bar readable over any fanart -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>120</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>b3000000</colordiffuse>
            </control>

            <!-- Stepped gradient: hero fades to dark at the bottom -->
            <control type="image">
                <left>0</left>
                <top>280</top>
                <width>1920</width>
                <height>100</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>26000000</colordiffuse>
            </control>
            <control type="image">
                <left>0</left>
                <top>380</top>
                <width>1920</width>
                <height>80</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>59000000</colordiffuse>
            </control>
            <control type="image">
                <left>0</left>
                <top>460</top>
                <width>1920</width>
                <height>80</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>99000000</colordiffuse>
            </control>
            <control type="image">
                <left>0</left>
                <top>540</top>
                <width>1920</width>
                <height>80</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>cc000000</colordiffuse>
            </control>

            <!-- Solid dark background for content rows -->
            <control type="image">
                <left>0</left>
                <top>620</top>
                <width>1920</width>
                <height>460</height>
                <texture>special://skin/media/white.png</texture>
                <colordiffuse>ff0d0d0d</colordiffuse>
            </control>

            <!-- ──────────────────────────────────────────────────
                 HERO SPOTLIGHT PANEL (Container 19010)
                 Transparent items — drives bg fanart + info overlay.
                 ────────────────────────────────────────────────── -->
            <control type="panel" id="19010">
                <left>0</left>
                <top>80</top>
                <width>1920</width>
                <height>540</height>
                <orient>horizontal</orient>
                <scrolltime>600</scrolltime>
                <preloaditems>3</preloaditems>
                <autoscroll>6000</autoscroll>
                <onup>19001</onup>
                <ondown>19020</ondown>
                <onfocus>SetProperty(TMDbHelper.WidgetContainer,19010,Home)</onfocus>
                <itemlayout width="1920" height="540">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>1920</width>
                        <height>540</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>00000000</colordiffuse>
                    </control>
                </itemlayout>
                <focusedlayout width="1920" height="540">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>1920</width>
                        <height>540</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>00000000</colordiffuse>
                    </control>
                </focusedlayout>
                <content>plugin://plugin.video.themoviedb.helper/?info=discover_movie&amp;type=movie&amp;sort_by=popularity.desc&amp;limit=20</content>
            </control>

            <!-- ──────────────────────────────────────────────────
                 HERO INFO OVERLAY
                 Uses TMDbHelper window properties set by the
                 widget container mechanism for reliable metadata.
                 ────────────────────────────────────────────────── -->
            <control type="group">
                <left>60</left>
                <top>388</top>
                <width>1040</width>
                <height>224</height>

                <!-- Genre tag -->
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>700</width>
                    <height>36</height>
                    <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.Genre)]</label>
                    <font>font_mini_bold</font>
                    <textcolor>main_fg_70</textcolor>
                    <wrap>false</wrap>
                </control>

                <!-- Featured title -->
                <control type="label">
                    <left>0</left>
                    <top>36</top>
                    <width>1040</width>
                    <height>84</height>
                    <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.Title)]</label>
                    <font>font_huge_bold</font>
                    <textcolor>main_fg_100</textcolor>
                    <shadowcolor>shadow_full</shadowcolor>
                    <wrap>false</wrap>
                </control>

                <!-- Plot description -->
                <control type="label">
                    <left>0</left>
                    <top>126</top>
                    <width>1040</width>
                    <height>50</height>
                    <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.Plot)]</label>
                    <font>font_mini</font>
                    <textcolor>main_fg_70</textcolor>
                    <scrolling>true</scrolling>
                    <wrap>false</wrap>
                </control>

                <!-- Year · Rating -->
                <control type="label">
                    <left>0</left>
                    <top>180</top>
                    <width>600</width>
                    <height>36</height>
                    <label>$INFO[Window(Home).Property(TMDbHelper.ListItem.Year)] [COLOR=main_fg_30]·[/COLOR] $INFO[Window(Home).Property(TMDbHelper.ListItem.Rating)]</label>
                    <font>font_tiny</font>
                    <textcolor>main_fg_50</textcolor>
                    <wrap>false</wrap>
                </control>
            </control>

            <!-- ──────────────────────────────────────────────────
                 "TOP PICKS FOR YOU" ROW  (in-progress movies)
                 Fanart background + clearlogo overlay per item.
                 Falls back to title text if no clearlogo.
                 Falls back to background colour if no fanart.
                 Panel ends at y=872.
                 ────────────────────────────────────────────────── -->
            <control type="label">
                <left>60</left>
                <top>628</top>
                <width>600</width>
                <height>36</height>
                <label>Top picks for you</label>
                <font>font_main_bold</font>
                <textcolor>main_fg_100</textcolor>
            </control>

            <control type="panel" id="19020">
                <left>40</left>
                <top>672</top>
                <width>1880</width>
                <height>200</height>
                <orient>horizontal</orient>
                <scrolltime>300</scrolltime>
                <preloaditems>4</preloaditems>
                <onup>19010</onup>
                <ondown>19030</ondown>
                <onfocus>SetProperty(TMDbHelper.WidgetContainer,19020,Home)</onfocus>

                <!-- Non-focused item -->
                <itemlayout width="450" height="200">
                    <!-- Dark tile background (shows when no fanart) -->
                    <control type="image">
                        <left>20</left>
                        <top>0</top>
                        <width>410</width>
                        <height>194</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>ff1a1a1a</colordiffuse>
                    </control>
                    <!-- Fanart with diffuse rounded corners -->
                    <control type="image">
                        <left>20</left>
                        <top>0</top>
                        <width>410</width>
                        <height>194</height>
                        <texture background="true" diffuse="diffuse/landscape_w356_h200.png">$INFO[ListItem.Art(fanart)]</texture>
                        <aspectratio>scale</aspectratio>
                        <colordiffuse>b3ffffff</colordiffuse>
                    </control>
                    <!-- Bottom gradient for logo/title readability -->
                    <control type="image">
                        <left>20</left>
                        <top>124</top>
                        <width>410</width>
                        <height>70</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>cc000000</colordiffuse>
                    </control>
                    <!-- ClearLogo overlay -->
                    <control type="image">
                        <left>30</left>
                        <top>132</top>
                        <width>390</width>
                        <height>54</height>
                        <texture background="true">$INFO[ListItem.Art(clearlogo)]</texture>
                        <aspectratio scalediffuse="false" aligny="center">keep</aspectratio>
                        <colordiffuse>ddffffff</colordiffuse>
                        <visible>!String.IsEmpty(ListItem.Art(clearlogo))</visible>
                    </control>
                    <!-- Title fallback (no clearlogo) -->
                    <control type="label">
                        <left>30</left>
                        <top>154</top>
                        <width>390</width>
                        <height>30</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font_mini_bold</font>
                        <textcolor>main_fg_90</textcolor>
                        <wrap>false</wrap>
                        <visible>String.IsEmpty(ListItem.Art(clearlogo))</visible>
                    </control>
                </itemlayout>

                <!-- Focused item: scale up, white border, full-bright -->
                <focusedlayout width="450" height="200">
                    <!-- Dark tile background -->
                    <control type="image">
                        <left>13</left>
                        <top>-7</top>
                        <width>424</width>
                        <height>208</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>ff1a1a1a</colordiffuse>
                    </control>
                    <!-- Fanart with diffuse rounded corners, scaled up -->
                    <control type="image">
                        <left>13</left>
                        <top>-7</top>
                        <width>424</width>
                        <height>208</height>
                        <texture background="true" diffuse="diffuse/landscape_w356_h200.png">$INFO[ListItem.Art(fanart)]</texture>
                        <aspectratio>scale</aspectratio>
                    </control>
                    <!-- White selection border -->
                    <control type="image">
                        <left>10</left>
                        <top>-10</top>
                        <width>430</width>
                        <height>214</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>00000000</colordiffuse>
                        <bordertexture>special://skin/media/white.png</bordertexture>
                        <bordersize>3</bordersize>
                        <colorborderdiffuse>ffffffff</colorborderdiffuse>
                    </control>
                    <!-- Bottom gradient -->
                    <control type="image">
                        <left>13</left>
                        <top>134</top>
                        <width>424</width>
                        <height>67</height>
                        <texture>special://skin/media/white.png</texture>
                        <colordiffuse>cc000000</colordiffuse>
                    </control>
                    <!-- ClearLogo overlay -->
                    <control type="image">
                        <left>23</left>
                        <top>142</top>
                        <width>404</width>
                        <height>54</height>
                        <texture background="true">$INFO[ListItem.Art(clearlogo)]</texture>
                        <aspectratio scalediffuse="false" aligny="center">keep</aspectratio>
                        <visible>!String.IsEmpty(ListItem.Art(clearlogo))</visible>
                    </control>
                    <!-- Title fallback (no clearlogo) -->
                    <control type="label">
                        <left>23</left>
                        <top>164</top>
                        <width>404</width>
                        <height>30</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font_mini_bold</font>
                        <textcolor>main_fg_100</textcolor>
                        <wrap>false</wrap>
                        <visible>String.IsEmpty(ListItem.Art(clearlogo))</visible>
                    </control>
                </focusedlayout>

                <content>videodb://movies/inprogress/</content>
            </control>

            <!-- ──────────────────────────────────────────────────
                 "YOUR APPS" ROW
                 Video add-on sources as rounded-corner icons.
                 Container starts y=922, height=158 → ends y=1080.
                 ────────────────────────────────────────────────── -->
            <control type="label">
                <left>60</left>
                <top>882</top>
                <width>400</width>
                <height>36</height>
                <label>Your apps</label>
                <font>font_main_bold</font>
                <textcolor>main_fg_100</textcolor>
            </control>

            <control type="panel" id="19030">
                <left>40</left>
                <top>922</top>
                <width>1880</width>
                <height>158</height>
                <orient>horizontal</orient>
                <scrolltime>300</scrolltime>
                <preloaditems>6</preloaditems>
                <onup>19020</onup>
                <ondown>19001</ondown>

                <itemlayout width="160" height="158">
                    <control type="image">
                        <left>20</left>
                        <top>4</top>
                        <width>120</width>
                        <height>120</height>
                        <texture background="true" diffuse="diffuse/square_w294_h294.png">$INFO[ListItem.Icon]</texture>
                        <aspectratio>scale</aspectratio>
                        <colordiffuse>b3ffffff</colordiffuse>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>128</top>
                        <width>160</width>
                        <height>26</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font_tiny</font>
                        <textcolor>main_fg_50</textcolor>
                        <align>center</align>
                        <wrap>false</wrap>
                    </control>
                </itemlayout>

                <focusedlayout width="160" height="158">
                    <control type="image">
                        <left>13</left>
                        <top>-4</top>
                        <width>134</width>
                        <height>134</height>
                        <texture background="true" diffuse="diffuse/square_w294_h294.png">$INFO[ListItem.Icon]</texture>
                        <aspectratio>scale</aspectratio>
                    </control>
                    <control type="label">
                        <left>0</left>
                        <top>128</top>
                        <width>160</width>
                        <height>26</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font_tiny</font>
                        <textcolor>main_fg_100</textcolor>
                        <align>center</align>
                        <wrap>false</wrap>
                    </control>
                </focusedlayout>

                <content>addons://sources/video/</content>
            </control>

            <!-- ──────────────────────────────────────────────────
                 TOP NAVIGATION BAR
                 Drawn last so it renders on top of all layers.
                 ────────────────────────────────────────────────── -->
            <control type="group">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>80</height>

                <!-- Semi-transparent tint behind nav bar -->
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1920</width>
                    <height>80</height>
                    <texture>special://skin/media/white.png</texture>
                    <colordiffuse>40000000</colordiffuse>
                </control>

                <!-- Profile / avatar button -->
                <control type="button" id="19000">
                    <left>32</left>
                    <top>16</top>
                    <width>48</width>
                    <height>48</height>
                    <texturefocus>special://skin/extras/icons/circle-user.png</texturefocus>
                    <texturenofocus>special://skin/extras/icons/circle-user.png</texturenofocus>
                    <colordiffuse>b3ffffff</colordiffuse>
                    <colorfocuseddiffuse>ffffffff</colorfocuseddiffuse>
                    <onclick>ActivateWindow(profiles)</onclick>
                    <onright>19001</onright>
                    <ondown>19010</ondown>
                </control>

                <!-- "For You" tab (active; white underline) -->
                <control type="button" id="19001">
                    <left>104</left>
                    <top>14</top>
                    <width>180</width>
                    <height>52</height>
                    <label>For You</label>
                    <font>font_main_bold</font>
                    <textcolor>main_fg_100</textcolor>
                    <focusedcolor>main_fg_100</focusedcolor>
                    <texturefocus />
                    <texturenofocus />
                    <align>center</align>
                    <aligny>center</aligny>
                    <onclick>ActivateWindow(Home)</onclick>
                    <onleft>19000</onleft>
                    <onright>19002</onright>
                    <ondown>19010</ondown>
                </control>
                <control type="image">
                    <left>124</left>
                    <top>71</top>
                    <width>140</width>
                    <height>3</height>
                    <texture>special://skin/media/white.png</texture>
                    <colordiffuse>ffffffff</colordiffuse>
                </control>

                <control type="button" id="19002">
                    <left>300</left>
                    <top>14</top>
                    <width>160</width>
                    <height>52</height>
                    <label>Movies</label>
                    <font>font_main</font>
                    <textcolor>main_fg_70</textcolor>
                    <focusedcolor>main_fg_100</focusedcolor>
                    <texturefocus />
                    <texturenofocus />
                    <align>center</align>
                    <aligny>center</aligny>
                    <onclick>ActivateWindow(1101)</onclick>
                    <onleft>19001</onleft>
                    <onright>19003</onright>
                    <ondown>19010</ondown>
                </control>

                <control type="button" id="19003">
                    <left>470</left>
                    <top>14</top>
                    <width>140</width>
                    <height>52</height>
                    <label>Shows</label>
                    <font>font_main</font>
                    <textcolor>main_fg_70</textcolor>
                    <focusedcolor>main_fg_100</focusedcolor>
                    <texturefocus />
                    <texturenofocus />
                    <align>center</align>
                    <aligny>center</aligny>
                    <onclick>ActivateWindow(1102)</onclick>
                    <onleft>19002</onleft>
                    <onright>19004</onright>
                    <ondown>19010</ondown>
                </control>

                <control type="button" id="19004">
                    <left>620</left>
                    <top>14</top>
                    <width>120</width>
                    <height>52</height>
                    <label>Apps</label>
                    <font>font_main</font>
                    <textcolor>main_fg_70</textcolor>
                    <focusedcolor>main_fg_100</focusedcolor>
                    <texturefocus />
                    <texturenofocus />
                    <align>center</align>
                    <aligny>center</aligny>
                    <onclick>ActivateWindow(programs)</onclick>
                    <onleft>19003</onleft>
                    <onright>19005</onright>
                    <ondown>19010</ondown>
                </control>

                <control type="button" id="19005">
                    <left>750</left>
                    <top>14</top>
                    <width>140</width>
                    <height>52</height>
                    <label>Library</label>
                    <font>font_main</font>
                    <textcolor>main_fg_70</textcolor>
                    <focusedcolor>main_fg_100</focusedcolor>
                    <texturefocus />
                    <texturenofocus />
                    <align>center</align>
                    <aligny>center</aligny>
                    <onclick>ActivateWindow(videos)</onclick>
                    <onleft>19004</onleft>
                    <onright>19006</onright>
                    <ondown>19010</ondown>
                </control>

                <!-- Search -->
                <control type="button" id="19006">
                    <left>1596</left>
                    <top>18</top>
                    <width>44</width>
                    <height>44</height>
                    <texturefocus>special://skin/extras/icons/search.png</texturefocus>
                    <texturenofocus>special://skin/extras/icons/search.png</texturenofocus>
                    <colordiffuse>b3ffffff</colordiffuse>
                    <colorfocuseddiffuse>ffffffff</colorfocuseddiffuse>
                    <onclick>ActivateWindow(1105)</onclick>
                    <onleft>19005</onleft>
                    <onright>19007</onright>
                    <ondown>19010</ondown>
                </control>

                <!-- Settings -->
                <control type="button" id="19007">
                    <left>1652</left>
                    <top>18</top>
                    <width>44</width>
                    <height>44</height>
                    <texturefocus>special://skin/extras/icons/gear.png</texturefocus>
                    <texturenofocus>special://skin/extras/icons/gear.png</texturenofocus>
                    <colordiffuse>b3ffffff</colordiffuse>
                    <colorfocuseddiffuse>ffffffff</colorfocuseddiffuse>
                    <onclick>ActivateWindow(settings)</onclick>
                    <onleft>19006</onleft>
                    <onright>19005</onright>
                    <ondown>19010</ondown>
                </control>

            </control>
            <!-- End Top Navigation Bar -->

        </definition>
    </include>

</includes>
